{
  "name": "aqar",
  "private": true,
  "version": "0.1.0",
  "description": "Aqar — open-source property operations ledger with an agentic maintenance layer (Jordan/MENA-first)",
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "node scripts/ci/typecheck-all.mjs",
    "lint": "oxlint",
    "test": "turbo run test",
    "test:unit": "pnpm --filter @aqar/core exec vitest run --exclude '**/*.property.test.ts'",
    "test:property": "pnpm --filter @aqar/core exec vitest run property",
    "test:integration": "pnpm --filter @aqar/db test",
    "test:e2e": "pnpm --filter @aqar/web test:e2e",
    "evals": "pnpm --filter @aqar/evals evals",
    "db:migrate": "pnpm --filter @aqar/db migrate",
    "db:seed": "pnpm --filter @aqar/db seed",
    "check:core-deps": "node scripts/check-core-deps.mjs",
    "checks": "node scripts/ci/checks.mjs",
    "lint:parity": "node scripts/ci/lint-parity.mjs",
    "test:select": "node scripts/ci/select-tests.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:selector": "node scripts/ci/select-tests.selftest.mjs",
    "shard:verify": "node scripts/ci/shard.mjs --package packages/core --shards 4 --verify",
    "test:inventory": "node scripts/ci/test-inventory.mjs --check",
    "test:inventory:record": "node scripts/ci/test-inventory.mjs --record",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "globals": "^17.14.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3"
  }
}
