    "@aqar/tools": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bullmq": "^6.7.8",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
