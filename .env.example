# --- Database (infra/docker-compose.yml maps host 5433 -> pg16+pgvector) ---
DATABASE_URL=postgres://aqar:***@127.0.0.1:5433/aqar
# --- Redis (host 6380) ---
REDIS_URL=redis://127.0.0.1:6380
# --- Model providers (OpenAI-compatible). Cloud DISABLED by default. ---
# Chat model: any OpenAI-compatible server. Dev default below is the
# local MLX lane; :8002-style embeddings-only servers will 404 on chat.
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=lfm3-local
CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_API_KEY=
*** --- Embeddings: local ONNX only, never cloud ---
EMBEDDING_MODEL=Xenova/multilingual-e5-small
# --- S3-compatible storage (MinIO in dev) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=aqar-documents
S3_ACCESS_KEY=aqar_dev
S3_SECRET_KEY=aqar_dev_secret
# --- Auth ---
SESSION_SECRET=change-me-32-bytes-minimum-aaaaaaaa
SESSION_COOKIE_NAME=aqar_session
# --- Channels (fill to enable; signature verification enforced when set) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# --- Email (mailpit in dev: smtp://127.0.0.1:1025) ---
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=aqar@example.com
# --- Agent policy defaults ---
AGENT_MODE=dry_run
TRIAGE_CONFIDENCE_ESCALATE=0.7
